PORT=3000
NODE_ENV=development

# Transactions need a replica set, even a single-node one
MONGO_URI=mongodb://

REDIS_URL=redis://

JWT_SECRET=change-me-to-a-long-random-string
WEBHOOK_SECRET=change-me-to-another-long-random-string

# Set to false if you run the payout worker as a separate process
RUN_WORKER=true/false